<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="GridMapper.Views.Components.BorderedButton"
             x:Name="root"
             x:CompileBindings="False">
    <Button CornerRadius="0" 
            Background="Transparent" 
            Margin="0" 
            Padding="0" 
            Width="44" 
            Height="44">
        <DockPanel>
            <Border BorderThickness="3,0,0,0" 
                    DockPanel.Dock="Left"
                    BorderBrush="{Binding LeftBorderBrush, ElementName=root}" />
            <Border BorderThickness="0,3,0,0" 
                    DockPanel.Dock="Top"
                    BorderBrush="{Binding TopBorderBrush, ElementName=root}" />
            <Border BorderThickness="0,0,3,0" 
                    DockPanel.Dock="Right"
                    BorderBrush="{Binding RightBorderBrush, ElementName=root}" />
            <Border BorderThickness="0,0,0,3" 
                    DockPanel.Dock="Bottom"
                    BorderBrush="{Binding BottomBorderBrush, ElementName=root}" />
            <Image />
        </DockPanel>
    </Button>
</UserControl>