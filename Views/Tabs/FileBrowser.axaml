<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="GridMapper.Views.Tabs.FileBrowser"
             x:Name="root"
             x:CompileBindings="False">
    <Grid RowDefinitions="auto,auto, auto">
        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <Button Content="Select Map Metadata" />
            <TextBlock Text="{Binding MapMetadataFilePath, ElementName=root}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="1">
            <Button Content="Select Map Structure Data" />
            <TextBlock Text="{Binding MapStructureFilePath, ElementName=root}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="2">
            <Button Content="Select Cell Metadata" />
            <TextBlock Text="{Binding CellMetadataFilePath, ElementName=root}" />
        </StackPanel>
    </Grid>

</UserControl>
