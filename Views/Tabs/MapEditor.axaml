<UserControl    xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                x:Class="GridMapper.Views.Tabs.MapEditor"
                xmlns:vm="using:GridMapper.ViewModels.Tabs"
                x:DataType="vm:MapEditorViewModel">
    <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Horizontal">
            <Button Content="New" />
            <ComboBox   MaxDropDownHeight="128"
                        ItemsSource="{Binding MapOptions}"
                        Width="160">
                <!-- Content should be generated programly -->    
            </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Vertical"
                    IsVisible="{Binding SettingsVisible}">
            <!-- Map Biome ID -->
            <StackPanel Orientation="Horizontal"
                        Margin="3">
                <TextBlock  Text="Biome ID:" 
                            Grid.Column="0"
                            Grid.Row="0"
                            Padding="8" />
                <NumericUpDown  Minimum="0"
                                Maximum="255"
                                Increment="1"
                                FormatString="N0"
                                Grid.Column="1"
                                Grid.Row="0"
                                Width="110" />
            </StackPanel>
            <!-- Map Name -->
            <StackPanel Orientation="Horizontal"
                        Margin="3">
                <TextBlock  Text="Map name:" 
                            Grid.Column="0"
                            Grid.Row="1"
                            Padding="8" />
                <TextBox    PlaceholderText="This map name"
                            MaxLength="64"
                            TextWrapping="NoWrap"
                            Grid.Column="1"
                            Grid.Row="1"
                            Width="216" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
