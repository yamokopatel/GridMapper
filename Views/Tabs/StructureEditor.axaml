<UserControl    xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                x:Class="GridMapper.Views.Tabs.StructureEditor"
                xmlns:vm="using:GridMapper.ViewModels.Tabs"
                xmlns:components="using:GridMapper.Views.Components"
                x:DataType="vm:StructureEditorViewModel">
    <StackPanel Orientation="Vertical">
        <!-- Map Choose -->
        <ComboBox   MaxDropDownHeight="128"
                    Width="220"
                    PlaceholderText="Select map"
                    Margin="3" />
        <!-- West -->
        <StackPanel Orientation="Horizontal"
                    Margin="3" >
            <TextBlock  Text="At west:"
                        Padding="5" />
            <ComboBox   MaxDropDownHeight="72"
                        Width="108" />
        </StackPanel>
        <!-- North -->
        <StackPanel Orientation="Horizontal"
                    Margin="3">
            <TextBlock  Text="At north:"
                        Padding="5" />
            <ComboBox   MaxDropDownHeight="72"
                        Width="108" />
        </StackPanel>
        <!-- East -->
        <StackPanel Orientation="Horizontal"
                    Margin="3">
            <TextBlock  Text="At east:"
                        Padding="5" />
            <ComboBox   MaxDropDownHeight="72"
                        Width="108" />
        </StackPanel>
        <!-- South -->
        <StackPanel Orientation="Horizontal" 
                    Margin="3">
            <TextBlock  Text="At south:"
                        Padding="5" />
            <ComboBox   MaxDropDownHeight="72"
                        Width="108" />
        </StackPanel>
    </StackPanel>
</UserControl>
