<UserControl    xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                x:Class="GridMapper.Views.Tabs.StructureEditor"
                xmlns:vm="using:GridMapper.ViewModels.Tabs"
                xmlns:components="using:GridMapper.Views.Components"
                x:DataType="vm:StructureEditorViewModel">
    <StackPanel Orientation="Vertical">
        <!-- Map Choose -->
        <ComboBox   MaxDropDownHeight="128"
                    Width="220"
                    PlaceholderText="Select map"
                    Margin="3" />
        <Grid   RowDefinitions="auto, auto, auto, auto"
                ColumnDefinitions="auto, auto"
                RowSpacing="4"
                Margin="2">
            <!-- West -->
            <TextBlock  Text="At west:"
                        Padding="5"
                        Grid.Column="0"
                        Grid.Row="0" />
            <ComboBox   MaxDropDownHeight="72"
                        Width="108"
                        Grid.Column="1"
                        Grid.Row="0" />
            <!-- North -->
            <TextBlock  Text="At north:"
                        Padding="5"
                        Grid.Column="0"
                        Grid.Row="1" />
            <ComboBox   MaxDropDownHeight="72"
                        Width="108"
                        Grid.Column="1"
                        Grid.Row="1" />
            <!-- East -->
            <TextBlock  Text="At east:"
                        Padding="5"
                        Grid.Column="0"
                        Grid.Row="2" />
            <ComboBox   MaxDropDownHeight="72"
                        Width="108"
                        Grid.Column="1"
                        Grid.Row="2" />
            <!-- South -->
            <TextBlock  Text="At south:"
                        Padding="5"
                        Grid.Column="0"
                        Grid.Row="3" />
            <ComboBox   MaxDropDownHeight="72"
                        Width="108"
                        Grid.Column="1"
                        Grid.Row="3" />
        </Grid>
    </StackPanel>
</UserControl>
